{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.4.4"],
      "env": { "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}" }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83", "--headless", "--isolated", "--output-dir", ".playwright-mcp"]
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server@3.4.2"],
      "env": { "EXA_API_KEY": "${EXA_API_KEY}" }
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@0.2.22"],
      "env": { "TAVILY_API_KEY": "${TAVILY_API_KEY}" }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.33.4"],
      "env": { "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}" }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?read_only=true&features=docs"
    }
  }
}
