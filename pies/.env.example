# PIES environment variables. Copy to .env.local for development.
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.

# --- Supabase (required for auth + data) ---------------------------------
# Project Settings > API. The anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/automation only (n8n, Workers). Bypasses RLS. Never expose to the browser.
# Not used by the Phase 1 web app; listed so it is documented.
SUPABASE_SERVICE_ROLE_KEY=

# --- Access control -------------------------------------------------------
# Comma-separated list of emails allowed to sign in. Everyone else is refused.
PIES_ALLOWED_EMAILS=

# Public base URL of the app (used for magic-link redirects).
PIES_SITE_URL=http://localhost:3000

# --- AI providers (disabled until pricing verified in the Budget module) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Search providers (disabled until pricing verified) --------------------
BRAVE_SEARCH_API_KEY=

# --- Gmail OAuth (Phase 3; draft-only by policy) ----------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- n8n -> PIES webhook shared secret (Phase 2) ----------------------------
PIES_WEBHOOK_SECRET=
