# PIES environment variables. Copy to .env.local for development.
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.

# --- Supabase (required for auth + data) ---------------------------------
# Project Settings > API. The anon/publishable key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DO NOT SET. PIES never uses the service-role / secret key, and n8n must never hold it.
# If this is set, the Settings page shows a warning.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Access control -------------------------------------------------------
# Comma-separated list of emails allowed to sign in. Everyone else is refused.
PIES_ALLOWED_EMAILS=

# Public base URL of the app (magic-link redirects, sign-out origin check).
PIES_SITE_URL=http://localhost:3000

# --- Automation boundary (n8n -> PIES) --------------------------------------
# n8n receives ONLY the secret and integration id (as n8n variables), never a database key.
# Generate the secret with:  openssl rand -hex 32
PIES_AUTOMATION_SECRET=
# id of the row you create in public.automation_integrations
PIES_AUTOMATION_INTEGRATION_ID=
# Server-side only. Connects as the restricted pies_automation role (see DEPLOYMENT.md).
# Supabase pooler form: postgres://pies_automation.<project-ref>:<password>@<pooler-host>:6543/postgres
PIES_AUTOMATION_DATABASE_URL=

# --- AI providers (Phase 2; disabled until pricing verified) ----------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Search providers (Phase 2; disabled until pricing verified) ------------
BRAVE_SEARCH_API_KEY=

# --- Gmail OAuth (Phase 3; NOT connected; draft-only by application policy) --
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
